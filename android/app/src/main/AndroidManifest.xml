<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 调用 DeepSeek / 搜索 / 视觉 API -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Termux 连接：声明后才能用 com.termux.RUN_COMMAND 请 Termux 代跑命令。
         光有这行不够，用户还必须在 Termux 里打开 allow-external-apps。 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>

    <!-- 应用管理需要枚举已安装应用；这是自用工具，故申请该权限 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <!-- 文件读写。Android 10 起分区存储生效，写外部存储的旧权限仅对 API<=29 有意义；
         更高的版本走 Shizuku(shell) 落盘，不受分区存储限制。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <!-- 识图：从相册/相机取图 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!-- 长任务前台服务（批量 shell、录屏） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 系统级悬浮窗确认框。
         工具很容易把别的应用切到前台（am start、拉起设置页等），
         此时应用内弹窗会被盖住，用户必须先切回来才能确认。
         悬浮窗由系统合成，永远在最上层。属于特殊权限，需用户手动开启。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:label="PrivTasker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Shizuku 的 ContentProvider：负责把 binder 的权限授予本应用。
             authorities 必须用它约定的 "${applicationId}.shizuku" 形式。
             android:permission 约束只有系统能访问该 provider。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 的包可见性：不声明的话 getPackageInfo("com.termux")
             会直接抛 NameNotFoundException，我们就"看不到"Termux 装没装。 -->
        <package android:name="com.termux"/>
    </queries>
</manifest>
